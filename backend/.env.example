# Copy this file to .env and fill in the values.

# PostgreSQL connection string
# Local dev: use the shared dev DB link (sent in Discord)
# Production (Railway): use the Neon connection string from https://neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT secret — use a long random string in production (e.g. `openssl rand -base64 64`)
JWT_SECRET="change-me-in-production"

# Port the Express server listens on (Railway sets PORT automatically)
PORT=5001

# Node environment
NODE_ENV=development

# Deployed frontend URL — restricts CORS to your Vercel app only
# e.g. https://faber.vercel.app  (leave as localhost for local dev)
FRONTEND_URL="http://localhost:3000"

